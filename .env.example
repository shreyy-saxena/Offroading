# Supabase project settings — find these in your Supabase project's
# Settings > API page.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret: server-only, bypasses Row Level Security. Never expose to the
# browser or commit it. Used for admin-only operations (CSV mapping
# replace, sending queued/authority emails) that must run with elevated
# privileges regardless of the calling user's RLS grants.
SUPABASE_SERVICE_ROLE_KEY=

# Third-party APIs. GOOGLE_MAPS_API_KEY (ticket 06, migrated from
# LocationIQ per PRD 12.6) needs the Geocoding API and the *legacy*
# Places API enabled on its Cloud Console project (not "Places API
# (New)"), with billing enabled. RESEND_API_KEY is wired up in ticket 09.
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
